<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#F7F7F7"
    android:padding="16dp">

    <TextView
        android:id="@+id/textManageUsersTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MANAGE USERS mlep"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#202020"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="20dp" />

    <TextView
        android:id="@+id/textManageUsersDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable or disable safe-opening privileges for each user."
        android:textSize="15sp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:textColor="#666666"
        android:paddingBottom="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/userList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <Button
        android:id="@+id/buttonBackManageUsers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        android:text="Back to Home"
        android:textAllCaps="false" />

</LinearLayout>
