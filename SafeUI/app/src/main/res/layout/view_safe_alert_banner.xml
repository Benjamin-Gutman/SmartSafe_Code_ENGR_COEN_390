<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/safeAlertBanner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFF0E0"
    android:padding="14dp"
    android:layout_marginBottom="12dp"
    android:visibility="gone">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠ SAFE SECURITY ALERT"
        android:textColor="#A52A2A"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Unauthorized opening detected! Please check your safe and clear the alarm."
        android:textColor="#333333"
        android:textSize="14sp" />

    <Button
        android:id="@+id/buttonGoToSafe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Go to Manage Safe"
        android:textAllCaps="false"
        android:backgroundTint="#A52A2A"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/buttonDismissSafeAlert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dismiss"
        android:textAllCaps="false" />

</LinearLayout>
