<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#F5F6F8"
    android:paddingBottom="16dp">

    <include
        layout="@layout/view_safe_alert_banner" />

    <TextView
        android:id="@+id/textManageSafeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MANAGE SAFE"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#202020"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="20dp" />

    <Button
        android:id="@+id/buttonOpenSafe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open Safe"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:textAllCaps="false" />

    <TextView
        android:id="@+id/textSafeSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Safe access history"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/layoutSafeHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp" />

    </ScrollView>

    <Button
        android:id="@+id/buttonBackHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Home"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:textAllCaps="false" />

</LinearLayout>